{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "@strapi/icons#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "assets/**",
        "src/index.ts",
        "src/symbols-index.ts",
        "src/bold-index.ts",
        "src/fill-index.ts",
        "svgr.*.config.cjs"
      ],
      "outputs": ["dist/**", "src/icons/*", "src/symbols/*", "src/bold/*", "src/fill/*"]
    },
    "clean": {
      "cache": false,
      "persistent": true
    },
    "develop": {
      "cache": false,
      "persistent": true
    },
    "format": {},
    "lint": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:ts": {
      "dependsOn": ["^build"]
    }
  }
}
