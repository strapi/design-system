{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 120,
  "tabWidth": 2,
  "ignorePatterns": ["CHANGELOG.md"],
  "sortTailwindcss": {
    "stylesheet": "packages/design-system/src/next/styles.css",
    "functions": ["cn", "cva"]
  }
}
